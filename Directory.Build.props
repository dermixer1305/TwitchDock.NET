<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- C# 14 (SDK 10, required by global.json) provides the field keyword used to keep JSON defaults for init-only properties. -->
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Release candidate: pinned API coverage is complete; broader live verification remains. -->
    <Version>1.0.0-rc.1</Version>
    <Authors>TwitchDock contributors</Authors>
    <RepositoryUrl>https://github.com/dermixer1305/TwitchDock.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dermixer1305/TwitchDock.NET</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Independent, asynchronous Twitch SDK for modern .NET.</Description>
    <PackageTags>twitch;helix;eventsub;chat;oauth</PackageTags>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- Library projects: enable trimming, single-file and native AOT analyzers (warnings fail the build). -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship XML documentation for IntelliSense; not every self-describing member carries a summary. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
