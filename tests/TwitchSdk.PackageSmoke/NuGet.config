<?xml version="1.0" encoding="utf-8"?>
<!-- Restores the SDK only from locally packed artifacts (dotnet pack -o artifacts/packages); everything else from nuget.org.
     Package source mapping prevents a public package with the same ID from being picked up instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-sdk-packages" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-sdk-packages">
      <package pattern="TwitchSdk.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
